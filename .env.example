DATABASE_URL=postgresql://referral_app:replace-me@127.0.0.1:5432/referral_operations
JWT_SECRET=generate-a-unique-random-value-of-at-least-32-characters
CORS_ORIGINS=https://referrals.example.com
SERVER_PORT=3071
ORGANIZATION_POSTAL_ADDRESS=100 Main Street, City, ST 10001
OUTREACH_RECIPIENT_DAILY_LIMIT=1
OUTREACH_AGENT_DAILY_LIMIT=100
WORKER_INTERVAL_MS=10000

# One-time operator bootstrap; unset after `npm run create-admin --prefix server`.
BOOTSTRAP_ORGANIZATION=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Provider secrets are environment-only. The database stores these names, never values.
CRM_TOKEN=
CRM_WEBHOOK_SECRET=
EMAIL_TOKEN=
EMAIL_WEBHOOK_SECRET=
CALENDAR_TOKEN=
CALENDAR_WEBHOOK_SECRET=
ENRICHMENT_TOKEN=
ENRICHMENT_WEBHOOK_SECRET=
CONSENT_TOKEN=
CONSENT_WEBHOOK_SECRET=
SUPPRESSION_TOKEN=
SUPPRESSION_WEBHOOK_SECRET=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
